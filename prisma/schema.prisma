generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  emailActive Boolean?
  name        String?
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  coin        Int           @default(0)
  bonusCoupon Int           @default(0)
  delete      Boolean       @default(false)
  boards      Board[]
  boardChat   BoardChat[]
  Chat        Chat[]
  localUser   LocalUser?
  pay         PayDetail[]
  payUsage    PayUsage?
  products    Product[]
  productAuth ProductAuth[]
  socialUser  SocialUser?
}

model SocialUser {
  id           Int     @id @default(autoincrement())
  socialId     String  @unique
  type         String
  accessToken  String?
  refreshToken String?
  userId       Int     @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocalUser {
  id       Int    @id @default(autoincrement())
  memId    String
  email    String
  password String
  userId   Int    @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayUsage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  coin      Int      @default(0)
  coupon    Int      @default(0)
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayDetail {
  id           Int    @id @default(autoincrement())
  merchant_uid String
  name         String
  paid_amount  Int
  pg_provider  String
  buyer_name   String
  buyer_email  String
  userId       Int
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayProduct {
  id          Int @id @default(autoincrement())
  amount      Int
  basicCoin   Int
  bonusCoin   Int @default(0)
  bonusCoupon Int @default(0)
}

model Product {
  id          Int           @id @default(autoincrement())
  image       String
  title       String
  description String?
  tag         String        @default("")
  auth        Boolean       @default(false)
  ratio       String        @default("1")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      Int
  chats       Chat[]
  hashtag     HashTag?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productAuth ProductAuth[]
  productHit  ProductHit?

  @@index([userId])
}

model Board {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardChat   BoardChat[]
  boardHit    BoardHit?
  boardTag    BoardTag?

  @@index([userId])
}

model Chat {
  id          Int      @id @default(autoincrement())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productId   Int
  userId      Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model BoardChat {
  id          Int      @id @default(autoincrement())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boardId     Int
  userId      Int
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([userId])
}

model ProductAuth {
  id        Int     @id @default(autoincrement())
  productId Int
  userId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model ProductHit {
  id        Int     @id @default(autoincrement())
  hit       Int     @default(0)
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BoardHit {
  id      Int   @id @default(autoincrement())
  hit     Int   @default(0)
  boardId Int   @unique
  board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model HashTag {
  id        Int     @id @default(autoincrement())
  hashtag   String
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BoardTag {
  id      Int    @id @default(autoincrement())
  hashtag String
  boardId Int    @unique
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
}
